{
  "name": "dive-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Dive Club clip studio: clip -> file per person -> templates per concept -> Inflight review.",
  "scripts": {
    "dive": "bun cli/dive.ts",
    "dev": "bun cli/dive.ts sync --quiet && vite --port 4410 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun test core cli",
    "remotion": "remotion studio video/index.ts --port 4411"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@fontsource/archivo-black": "5.3.0",
    "@remotion/cli": "4.0.540",
    "@remotion/player": "4.0.540",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.540",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  }
}
